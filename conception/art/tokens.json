  "typo": {
    "famille": {
      "titre": {"$value": "Alegreya SC", "$type": "fontFamily", "$description": "OFL 1.1, Huerta Tipográfica ; graisses Bold et ExtraBold ; titres d'écran, de fenêtre, boutons primaires"},
      "texte": {"$value": "Alegreya Sans", "$type": "fontFamily", "$description": "OFL 1.1, Huerta Tipográfica ; Medium (texte), Bold (libellés, boutons) ; chiffres tabulaires (tnum) pour toute valeur qui change"},
      "secours-titre": {"$value": "Grenze Gotisch", "$type": "fontFamily", "$description": "OFL 1.1, Omnibus-Type ; seulement si le joueur choisit un titre plus marqué (logo, titres d'écran >= 36 px)"}
    },
    "taille": {
      "min": {"$value": 15, "$type": "dimension", "$description": "plancher de tout texte permanent (UiTheme.MIN_TEXT, 14 avec Nunito ; 15 avec Alegreya Sans, dont l'œil est plus petit : même taille apparente)"},
      "legende": {"$value": 15, "$type": "dimension", "$description": "légende, badge, raccourci"},
      "texte": {"$value": 17, "$type": "dimension", "$description": "texte courant, ligne de liste"},
      "fort": {"$value": 19, "$type": "dimension", "$description": "bouton, onglet, valeur d'une ligne"},
      "sous-titre": {"$value": 22, "$type": "dimension", "$description": "titre de section, nom d'objet dans une carte"},
      "titre-panneau": {"$value": 28, "$type": "dimension", "$description": "titre de fenêtre ou de panneau"},
      "titre-ecran": {"$value": 36, "$type": "dimension", "$description": "titre d'écran (PageScreen)"},
      "affiche": {"$value": 56, "$type": "dimension", "$description": "VICTOIRE, nom de zone, logo (une fois par écran au plus)"},
      "chiffre-hud": {"$value": 24, "$type": "dimension", "$description": "valeurs du HUD (PV, minuterie)"}
    },
    "interligne": {"serre": 1.15, "texte": 1.4, "paragraphe": 1.5},
    "approche": {"$description": "espacement des lettres en em", "titre-capitales": 0.04, "badge": 0.06, "texte": 0}
  },
  "espace": {
    "$description": "grille de 4 px ; marges intérieures et écarts uniquement parmi ces valeurs",
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64,
    "fenetre-marge": 24, "carte-marge": 16, "bouton-marge-h": 20, "bouton-marge-v": 10, "gouttiere-ecran": 32
  },
  "forme": {
    "chanfrein": {
      "$description": "coins coupés à 45° (jamais d'arrondi), en px à 1600x900",
      "fenetre": 10, "carte": 6, "bouton": 5, "case": 4, "badge": 3, "infobulle": 4
    },
    "rayon": {
      "$description": "seuls arrondis permis",
      "aucun": 0, "pastille-interrupteur": 999, "jauge-interieure": 2, "pierre-sertie": 999
    },
    "bordure": {
      "fenetre-externe": 2, "fenetre-interne": 1, "fenetre-ecart": 3,
      "carte": 1, "bouton": 1, "case": 2, "case-legendaire": 3, "focus-anneau": 2, "focus-ecart": 3, "separateur": 1
    },
    "ombre": {
      "fenetre": {"x": 0, "y": 6, "flou": 18, "couleur": "#000000", "opacite": 0.55},
      "carte": {"x": 0, "y": 2, "flou": 6, "couleur": "#000000", "opacite": 0.40},
      "creux-case": {"interieure": true, "y": 2, "flou": 6, "couleur": "#000000", "opacite": 0.6},
      "bouton": {"$description": "aucune ombre portée : biseau 1 px (haut or-300 à 35 %, bas bronze-800)"}
    },
    "lueur": {
      "focus": {"couleur": "#F3DDA5", "opacite-min": 0.25, "opacite-max": 0.45, "rayon": 6, "periode-ms": 1600},
      "legendaire": {"couleur": "#FBE7A6", "opacite-min": 0.15, "opacite-max": 0.35, "rayon": 8, "periode-ms": 2400}
    },
    "grain": {"$description": "bruit de fond des panneaux (texture tuilée 256 px)", "opacite": 0.035, "echelle-px": 1.5},
    "usure": {"$description": "irrégularité des bords de métal (bruit le long du contour)", "amplitude-px": 0.6, "frequence": 0.08}
  },
  "taille-composant": {
    "bouton-hauteur": {"petit": 32, "normal": 44, "primaire": 56},
    "onglet-hauteur": 40,
    "case": {"petite": 48, "normale": 64, "grande": 88},
    "jauge-hauteur": {"fine": 6, "normale": 12, "hud": 18, "boss": 22},
    "infobulle-largeur-max": 360,
    "cible-min-souris": 32,
    "cible-min-manette": 44
  },
  "mouvement": {
    "duree": {
      "$description": "ms",
      "pression": 80, "survol": 120, "focus": 140, "apparition": 180, "panneau": 220, "page": 280, "recompense": 450, "compteur": 700, "infobulle-delai": 350
    },
    "courbe": {
      "$description": "cubic-bezier ; équivalents Godot entre crochets",
      "sortie": {"$value": [0.22, 0.61, 0.36, 1.0], "godot": "TRANS_CUBIC, EASE_OUT", "$description": "tout ce qui entre ou répond"},
      "entree": {"$value": [0.55, 0.06, 0.68, 0.19], "godot": "TRANS_CUBIC, EASE_IN", "$description": "tout ce qui sort (plus court : 70 % de la durée d'entrée)"},
      "standard": {"$value": [0.45, 0.0, 0.55, 1.0], "godot": "TRANS_SINE, EASE_IN_OUT", "$description": "déplacements d'un point à un autre, lueurs qui respirent"},
      "ressort": {"$value": [0.34, 1.4, 0.64, 1.0], "godot": "TRANS_BACK, EASE_OUT", "$description": "récompenses seulement (dépassement 6 % au plus)"}
    },
    "distance": {"glissement-panneau": 16, "glissement-carte": 24, "pression-bouton": 1}
  },
  "son": {
    "$description": "niveaux relatifs à la musique (dB) ; voir BIBLE.md § Son",
    "survol": -24, "clic": -14, "confirmation": -10, "annulation": -14, "erreur": -12, "recompense": -6, "musique-baisse-bilan": -4
  }
}
